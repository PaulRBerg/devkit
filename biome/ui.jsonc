// Devkit UI configuration for Biome v2
//
// Extends base configuration with UI-specific rules for accessibility,
// React Compiler, and CSS modules support.
//
// IMPORTANT: Consumers must extend BOTH configs and add their own
// `files.includes` patterns. For example:
//
//   {
//     "extends": ["@prb/devkit/biome/base", "@prb/devkit/biome/ui"],
//     "files": {
//       "includes": ["**/*.{css,js,jsx,json,ts,tsx}", "!node_modules"]
//     }
//   }
{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "noDuplicateClasses": "on",
        "useSortedAttributes": "on"
      }
    }
  },
  "css": {
    "formatter": {
      "lineWidth": 100
    },
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useKeyWithClickEvents": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off" // doesn't work with React Compiler: https://github.com/biomejs/biome/issues/5293
      },
      "nursery": {
        // ESLint owns class ordering with the project's better-tailwindcss configuration.
        // Biome 2.6 supports Tailwind v4, but enabling a second sorter can conflict with that policy.
        "useTailwindSortedClasses": "off"
      },
      "performance": {
        // React Compiler memoizes callbacks; this rule cannot account for compiler output.
        // https://react.dev/reference/react/useCallback
        "noJsxPropsBind": "off"
      },
      "style": {
        // Promoted out of nursery in Biome 2.5.0.
        "useErrorCause": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "warn",
          "options": {
            // console.error allowed for error boundaries and critical failures
            "allow": ["error"]
          }
        }
      }
    }
  },
  "overrides": [
    // ── Styles files ─────────────────────────────────────────────────────────
    // Disable alphabetical sorting in styles files, where order is important for CSS
    {
      "includes": ["**/*.styles.ts"],
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      }
    }
  ]
}
